# FAULTLINE environment variables. Copy to `.env` (git-ignored) and fill in what you need.
# `make api` loads .env automatically. Every variable is optional: the app runs with none of them set.
# /api/health reports whether each optional key is configured (true/false only, never the value).

# Local model server for Blind Replay inference (Ollama). If unreachable, replay shows MODEL_UNAVAILABLE;
# no canned answer is ever substituted.
OLLAMA_BASE_URL=http://localhost:11434
# Ollama model tag the replay pipeline uses; /api/health checks it is installed (`ollama pull <tag>`).
FAULTLINE_OLLAMA_MODEL=llama3.1:8b

# Optional: hosted-model comparator (labeled "hosted-model comparison, not air-gapped"). Unset -> disabled.
ANTHROPIC_API_KEY=
# Optional: web search for online Live Explore mode only (never used in replay). Unset -> disabled.
TAVILY_API_KEY=

# Directory with versioned fixtures (default: services/api/data). manifest.json there is hashed by /api/health.
FAULTLINE_DATA_DIR=

# Prediction store (SQLite forecasts + reveal ledger) every route, the evaluator and scripts/record_runs.py open;
# computed scorecards go in scorecards/ next to it. Unset -> the OFFICIAL store services/api/var/predictions.sqlite3,
# which only the official recorded run (scripts/record_runs.py) should write. Stage demos: `make demo-scratch`.
FAULTLINE_PREDICTIONS_DB=

# Web origin allowed by CORS in local mode (always also http://localhost:3000 and http://127.0.0.1:3000).
FAULTLINE_WEB_ORIGIN=

# --- Deploy / public mode (docs/DEPLOY.md). Leave unset on a laptop: the default is local mode. ---
# local (default): every route open, no rate limit. public (the server image): model inference, Tavily search,
# reveals and benchmark compute need FAULTLINE_ADMIN_TOKEN; CORS https only; per-IP rate limit. Anything else
# stops the API at startup.
FAULTLINE_MODE=
# Public-mode admin token (openssl rand -hex 32). Under 32 characters stops the API at startup in public mode.
FAULTLINE_ADMIN_TOKEN=
# CORS allowlist (comma-separated) replacing FAULTLINE_PUBLIC_ORIGIN; default https://faultline.khayrul.com.
FAULTLINE_CORS_ORIGINS=
FAULTLINE_PUBLIC_ORIGIN=
# Per-IP requests per minute (default 120 in public mode, off in local mode; 0 disables).
FAULTLINE_RATE_LIMIT_PER_MIN=
# Maximum request body in bytes (default 65536).
FAULTLINE_MAX_BODY_BYTES=

# --- LIVE EXPLORE chat (POST /api/explore/chat, #187): hosted models that answer only with engine tool numbers. ---
# Keys are read at call time and never returned; /api/explore/chat/models says only whether each provider is usable.
# OpenAI and Claude models go only through their native APIs (never via OpenRouter); unset key -> those models unavailable.
OPENROUTER_API_KEY=
OPENAI_API_KEY=
# (ANTHROPIC_API_KEY above is also used by the chat for Claude models.)
# Optional pinned model list, comma-separated provider:model_id (openrouter|openai|anthropic). Unset -> runtime catalogue.
FAULTLINE_CHAT_MODELS=
# Chat turns per client IP per 10 minutes (default 10; 0 = off, local mode only). A valid admin token bypasses it.
FAULTLINE_CHAT_PER_IP=
# Chat turns running at once (default 4); more -> 503 BUSY.
FAULTLINE_CHAT_CONCURRENCY=
# Public catalogue price cap, USD per million output tokens (default 20). The admin token can use any model.
FAULTLINE_CHAT_MAX_PRICE_PER_MTOK=
# Daily spend ceiling in USD (default 25): reported tokens x catalogue price, in process memory (a restart resets it).
# Once reached, non-admin chat turns get 503 BUDGET until the next UTC day.
FAULTLINE_CHAT_DAILY_BUDGET_USD=
# Chat web_search backend (#214): auto (default) | anthropic | openai | tavily. auto = Tavily if TAVILY_API_KEY is set,
# else Anthropic Claude web search (ANTHROPIC_API_KEY; billed per search + tokens), else OpenAI web search
# (OPENAI_API_KEY). A forced provider without its key turns web_search off.
FAULTLINE_WEB_SEARCH_PROVIDER=
# Chat web_search daily caps (paid searches), per UTC day, in process memory, non-admin only:
# searches per client IP (default 30) and for all visitors together (default 500). 0 = no web search for visitors.
FAULTLINE_CHAT_WEB_PER_IP_DAY=
FAULTLINE_CHAT_WEB_DAILY=
# Public mode only: 1 = visitors may chat (admin-only otherwise).
FAULTLINE_PUBLIC_CHAT=
# Server only: 1 documents that deploy/docker-compose.chat-egress.yml is in use (the api container gets internet).
FAULTLINE_CHAT_EGRESS=
