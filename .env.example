# FAULTLINE environment variables. Copy to `.env` (git-ignored) and fill in what you need.
# `make api` loads .env automatically. Every variable is optional: the app runs with none of them set.
# /api/health reports whether each optional key is configured (true/false only, never the value).

# Local model server for Blind Replay inference (Ollama). If unreachable, replay shows MODEL_UNAVAILABLE;
# no canned answer is ever substituted.
OLLAMA_BASE_URL=http://localhost:11434
# Ollama model tag the replay pipeline uses; /api/health checks it is installed (`ollama pull <tag>`).
FAULTLINE_OLLAMA_MODEL=llama3.1:8b

# Optional: hosted-model comparator (labeled "hosted-model comparison, not air-gapped"). Unset -> disabled.
ANTHROPIC_API_KEY=
# Optional: web search for online Live Explore mode only (never used in replay). Unset -> disabled.
TAVILY_API_KEY=

# Directory with versioned fixtures (default: services/api/data). manifest.json there is hashed by /api/health.
FAULTLINE_DATA_DIR=

# Prediction store (SQLite forecasts + reveal ledger) every route, the evaluator and scripts/record_runs.py open;
# computed scorecards go in scorecards/ next to it. Unset -> the OFFICIAL store services/api/var/predictions.sqlite3,
# which only the official recorded run (scripts/record_runs.py) should write. Stage demos: `make demo-scratch`.
FAULTLINE_PREDICTIONS_DB=

# Web origin allowed by CORS (default: http://localhost:3000, plus http://127.0.0.1:3000).
FAULTLINE_WEB_ORIGIN=
