# Server-side settings for deploy/docker-compose.yml. Copy to deploy/.env ON THE SERVER (git-ignored), chmod 600.
# Never commit deploy/.env. See docs/DEPLOY.md.

# --- The two public names. Rename the site by changing these, the repo variables, and DNS (docs/DEPLOY.md) ---
# Host Caddy serves and gets a certificate for. Must match the repo variable FAULTLINE_API_HOST.
FAULTLINE_API_HOST=api.faultline.khayrul.com
# The web app origin (GitHub Pages). Must match the repo variable FAULTLINE_PUBLIC_ORIGIN. Default CORS allowlist.
FAULTLINE_PUBLIC_ORIGIN=https://faultline.khayrul.com

# Optional: comma-separated CORS allowlist replacing the default above (https origins only in public mode).
FAULTLINE_CORS_ORIGINS=

# Live model inference on the server (POST /api/replay/run with "Authorization: Bearer <token>").
# Leave empty to keep inference fully disabled in public mode. Generate: openssl rand -hex 32.
# Anything other than 64 lower-case hex characters stops the API at startup (ConfigError).
FAULTLINE_ADMIN_TOKEN=

# Per-IP requests per minute (token bucket; burst = the same number). 600 because CASCADE sends simulate + optimize
# on every change and judges in one room share a NAT address (docs/DEPLOY.md). Public mode refuses 0 (ConfigError).
FAULTLINE_RATE_LIMIT_PER_MIN=600
# Maximum request body in bytes (Caddy also caps bodies at 64KiB = 65536).
FAULTLINE_MAX_BODY_BYTES=65536

# Optional internal Ollama container (CPU only, never published). Uncomment to start it with the stack.
# COMPOSE_PROFILES=ollama
FAULTLINE_OLLAMA_MODEL=llama3.1:8b
