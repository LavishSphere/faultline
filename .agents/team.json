        ".env.example",
        "README.md"
      ]
    },
    "ws:replay": {
      "agent": "backend-engineer",
      "paths": [
        "services/api/core/temporal_gate.py",
        "services/api/core/provenance.py",
        "services/api/core/forecasting.py",
        "services/api/data/demo_cases/",
        "services/api/data/sealed_outcomes/",
        "docs/CASES.md"
      ]
    },
    "ws:eval": {
      "agent": "backend-engineer",
      "paths": [
        "services/api/core/evaluator.py",
        "scripts/run_benchmark.py",
        "docs/EVALUATION_PROTOCOL.md"
      ]
    },
    "ws:finance": {
      "agent": "finance-modeler",
      "paths": [
        "services/api/core/financials.py",
        "services/api/core/optimizer.py",
        "services/api/data/demo_business.json",
        "docs/MATH_MODEL.md"
      ]
    },
    "ws:markets": {
      "agent": "market-data-engineer",
