    },
    "ws:research": {
      "agent": "research-curator",
      "paths": [
        "services/api/data/research_lenses.json",
        "docs/DATA_PROVENANCE.md",
        "docs/curation/"
      ]
    }
  },
  "shared_files": [
    "services/api/main.py",
    "services/api/models.py",
    "apps/web/lib/api.ts"
  ],
  "integrity_core": [
    "services/api/core/",
    "services/api/agents/",
    "services/api/routes/",
    "services/api/data/sealed_outcomes/",
    "services/api/data/demo_cases/",
    "services/api/markets/normalize.py",
