    {
      "at": "2026-11-15T11:00:00-05:00",
      "name": "code freeze",
      "when": "Sun Nov 15, 11am ET",
      "after": "CODE FREEZE: nothing merges and no new PRs unless a lead says so in this session."
    },
    {
      "at": "2026-11-15T13:00:00-05:00",
      "name": "Demo Day 1.0",
      "when": "Sun Nov 15, 1pm ET"
    }
  ],
  "workstreams": {
    "ws:backend": {
      "agent": "backend-engineer",
      "paths": [
        "services/api/main.py",
        "services/api/models.py",
        "services/api/errors.py",
        "services/api/routes/",
        "services/api/agents/",
